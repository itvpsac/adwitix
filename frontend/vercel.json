{
  "rewrites": [
    {
      "source": "/api/v1/:path*",
      "destination": "https://admin.adwitix.com/public/index.php/api/v1/:path*"
    },
    {
      "source": "/uploads/:path*",
      "destination": "https://admin.adwitix.com/public/uploads/:path*"
    },
    {
      "source": "/ticker-feed",
      "destination": "https://admin.adwitix.com/public/index.php/ticker-feed"
    },
    {
      "source": "/chronicles/:path*",
      "destination": "https://admin.adwitix.com/public/index.php/chronicles/:path*"
    },
    {
      "source": "/chronicle/verify/:path*",
      "destination": "https://admin.adwitix.com/public/index.php/chronicle/verify/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
