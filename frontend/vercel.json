{
  "rewrites": [
    {
      "source": "/api/v1/:path*",
      "destination": "https://admin.adwitix.com/api/v1/:path*"
    },
    {
      "source": "/uploads/:path*",
      "destination": "https://admin.adwitix.com/uploads/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
